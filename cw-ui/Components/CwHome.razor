@page "/plugin/cw-ui/home"
@* CW UI 独立页面：宿主 Router 通过 AdditionalAssemblies 发现本路由，默认套用 MainLayout。 *@
@inject NavigationManager Nav

<div class="cw-page">
    <div class="cw-card">
        <div class="cw-head">
            <span class="cw-title">CW 界面</span>
            <span class="cw-en">CW UI</span>
        </div>
        <p class="cw-body">cw-ui 插件已运行。修改本页与 plugin.css 即可扩展 CW 的界面。</p>
        <div class="cw-actions">
            <button type="button" class="cw-btn" @onclick='() => Nav.NavigateTo("/menu")'>‹ 返回主菜单</button>
        </div>
    </div>
</div>
