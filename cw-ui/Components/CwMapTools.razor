@* 大厅地图工具条按钮（宿主槽位 page.skirmish.map.tools）：
   直接在弹窗里生成，避免跳页离开当前大厅会话。 *@

<button type="button" class="mt-btn cw-mt-gen" title="@CwText.T("MapTools.GenerateTitle", "生成随机地图")" @onclick="() => _open = true">
    <span class="mt-label">@CwText.T("MapTools.Generate", "生成")</span>
</button>

@if (_open)
{
    <div class="cw-rm-backdrop" @onclick="Close">
        <div @onclick:stopPropagation="true">
            <CwRandomMapPanel OnClose="Close" />
        </div>
    </div>
}

@code {
    private bool _open;

    private void Close() => _open = false;
}
