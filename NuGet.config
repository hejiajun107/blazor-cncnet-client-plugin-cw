<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- 插件契约 SDK：由客户端仓库 tools/publish.ps1 -PackPluginSdk 产出。
         路径相对于本文件；仓库位置变化时改这里，或改用 dotnet nuget add source 全局注册。 -->
    <add key="cncnet-client-local" value="..\blazor-cncnet-client\blazor-cncnet-client\dist\nuget" />
  </packageSources>
</configuration>
